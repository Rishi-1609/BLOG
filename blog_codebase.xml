 * /api/blogs:
 *  post:
 *      summary: Create a blog (auth required)
 *      tags: [Blogs]
 *      security:
 *          - bearerAuth: []
 *      requestBody:
 *          required: true
 *          content:
 *              multipart/form-data:
 *                  schema:
